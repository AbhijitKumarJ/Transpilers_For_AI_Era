public static class Ast
{
    [MapsTo("_ConstantValue")]
    public static extern TypeAlias _ConstantValue { get; }
    [MapsTo("parse")]
    public static extern _T Parse(_T source, string filename = "<unknown>", string mode = "exec");
    [MapsTo("parse")]
    public static extern Module Parse(string source, string filename = "<unknown>", string mode = "exec");
    [MapsTo("parse")]
    public static extern Module Parse(ReadableBuffer source, string filename = "<unknown>", string mode = "exec");
    [MapsTo("parse")]
    public static extern Expression Parse(string source, bytes filename, string mode);
    [MapsTo("parse")]
    public static extern Expression Parse(string source, PathLike<object> filename, string mode);
    [MapsTo("parse")]
    public static extern Expression Parse(ReadableBuffer source, bytes filename, string mode);
    [MapsTo("parse")]
    public static extern Expression Parse(ReadableBuffer source, PathLike<object> filename, string mode);
    [MapsTo("literal_eval")]
    public static extern object LiteralEval(string node_or_string);
    [MapsTo("literal_eval")]
    public static extern object LiteralEval(AST node_or_string);
    [MapsTo("dump")]
    public static extern string Dump(AST node, bool annotate_fields = true, bool include_attributes = false);
    [MapsTo("copy_location")]
    public static extern _T CopyLocation(_T new_node, AST old_node);
    [MapsTo("fix_missing_locations")]
    public static extern _T FixMissingLocations(_T node);
    [MapsTo("increment_lineno")]
    public static extern _T IncrementLineno(_T node, int n = 1);
    [MapsTo("iter_fields")]
    public static extern IEnumerable<(string, object)> IterFields(AST node);
    [MapsTo("iter_child_nodes")]
    public static extern IEnumerable<AST> IterChildNodes(AST node);
    [MapsTo("get_docstring")]
    public static extern string? GetDocstring(AsyncFunctionDef node, bool clean = true);
    [MapsTo("get_docstring")]
    public static extern string? GetDocstring(FunctionDef node, bool clean = true);
    [MapsTo("get_docstring")]
    public static extern string? GetDocstring(ClassDef node, bool clean = true);
    [MapsTo("get_docstring")]
    public static extern string? GetDocstring(Module node, bool clean = true);
    [MapsTo("get_source_segment")]
    public static extern string? GetSourceSegment(string source, AST node);
    [MapsTo("walk")]
    public static extern IEnumerable<AST> Walk(AST node);
    [MapsTo("unparse")]
    public static extern string Unparse(AST ast_obj);
    [MapsTo("main")]
    public static extern void Main();
}
