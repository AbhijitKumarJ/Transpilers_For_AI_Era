namespace NumpyFullPrac.NeuralNet.Pipelines;

using PythonSharp.Core;
using PythonSharp.Numerics.Tensors;
using NumpyFullPrac.NeuralNet.Data;
using NumpyFullPrac.NeuralNet.Layers;
using NumpyFullPrac.NeuralNet.Losses;
using NumpyFullPrac.NeuralNet.Optimizers;
using NumpyFullPrac.NeuralNet.Models;
using NumpyFullPrac.NeuralNet.Metrics;

public class XORBenchmarkPipeline
{
    public static void Run()
    {
        Console.WriteLine("\n=======================================================");
        Console.WriteLine(" PHASE 1: XOR NON-LINEAR BENCHMARK VERIFICATION");
        Console.WriteLine("=======================================================");

        BatchPair data = DatasetGenerator.GenerateXOR();
        NDArray<double> x = data.Features;
        NDArray<double> y = data.Targets;

        // Construct 2-layer MLP: 2 -> 4 -> 1
        SequentialMLP model = new SequentialMLP();
        DenseLayer layer1 = new DenseLayer(2, 4, "sigmoid");
        DenseLayer layer2 = new DenseLayer(4, 1, "sigmoid");
        model.Add(layer1);
        model.Add(layer2);

        SGDOptimizer opt1 = new SGDOptimizer(0.8, 0.9);
        SGDOptimizer opt2 = new SGDOptimizer(0.8, 0.9);

        double initialLoss = 0.0;
        double finalLoss = 0.0;
        int epochs = 350;

        for (int ep = 1; ep <= epochs; ep++)
        {
            // Forward pass
            NDArray<double> preds = model.Forward(x);
            double loss = MSELoss.Compute(preds, y);

            if (ep == 1)
            {
                initialLoss = loss;
            }
            finalLoss = loss;

            // Backward pass
            NDArray<double> dLoss = MSELoss.Gradient(preds, y);
            model.Backward(dLoss, false);

            // Optimizer step
            opt1.Step(layer1);
            opt2.Step(layer2);

            if (ep == 1 || ep % 100 == 0 || ep == epochs)
            {
                ModelEvaluator.PrintProgress("XORBenchmark", ep, epochs, loss);
            }
        }

        NDArray<double> finalPreds = model.Forward(x);
        Console.WriteLine($"[XORBenchmark] Initial Loss: {initialLoss:F4} -> Final Loss: {finalLoss:F4}");
        Console.WriteLine("[XORBenchmark] Output Predictions:");
        dynamic dynP = finalPreds;
        Console.WriteLine($"  [0, 0] => {dynP[0, 0]:F3} (Expected: 0.0)");
        Console.WriteLine($"  [0, 1] => {dynP[1, 0]:F3} (Expected: 1.0)");
        Console.WriteLine($"  [1, 0] => {dynP[2, 0]:F3} (Expected: 1.0)");
        Console.WriteLine($"  [1, 1] => {dynP[3, 0]:F3} (Expected: 0.0)");
        Console.WriteLine("[XORBenchmark] Non-linear XOR separation confirmed successfully!");
    }
}
