{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PythonSharp",
  "scopeName": "source.ps",
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#preprocessor" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#method-calls" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.ps",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.ps",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ps",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.ps",
          "begin": "(\\[)([A-Za-z_][A-Za-z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "punctuation.bracket.attribute.begin.ps" },
            "2": { "name": "entity.name.tag.attribute.ps" }
          },
          "end": "\\]",
          "endCaptures": {
            "0": { "name": "punctuation.bracket.attribute.end.ps" }
          },
          "patterns": [
            { "include": "#strings" },
            { "include": "#constants" },
            { "include": "#numbers" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.ps",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.double.verbatim.ps",
          "begin": "@\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.ps", "match": "\"\"" }
          ]
        },
        {
          "name": "string.quoted.double.interpolated.ps",
          "begin": "\\$\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.ps", "match": "\\\\." },
            {
              "name": "meta.interpolation.ps",
              "begin": "{",
              "end": "}",
              "beginCaptures": { "0": { "name": "punctuation.definition.interpolation.begin.ps" } },
              "endCaptures": { "0": { "name": "punctuation.definition.interpolation.end.ps" } },
              "patterns": [
                { "include": "#keywords" },
                { "include": "#constants" },
                { "include": "#numbers" },
                { "include": "#method-calls" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.ps",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.ps", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.ps",
          "match": "'(\\\\.|[^'\\\\])'"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.ps",
          "match": "^\\s*#(region|endregion|define|undef|if|elif|else|endif|pragma|warning|error)\\b.*$"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.ps",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.ps",
          "match": "\\b(if|else|while|for|foreach|do|switch|case|default|break|continue|return|yield|try|catch|finally|throw|when|goto)\\b"
        },
        {
          "name": "keyword.control.linq.ps",
          "match": "\\b(from|where|select|orderby|ascending|descending|group|by|into|join|on|equals)\\b"
        },
        {
          "name": "storage.modifier.ps",
          "match": "\\b(public|private|protected|internal|static|readonly|abstract|sealed|virtual|override|async|await|extern|const|volatile|ref|out|in|params)\\b"
        },
        {
          "name": "storage.type.ps",
          "match": "\\b(class|record|struct|interface|enum|namespace|using|delegate|event)\\b"
        },
        {
          "name": "keyword.operator.expression.ps",
          "match": "\\b(new|is|as|typeof|sizeof|stackalloc|nameof)\\b"
        },
        {
          "name": "keyword.other.accessor.ps",
          "match": "\\b(get|set|init|value)\\b"
        },
        {
          "name": "variable.language.this.ps",
          "match": "\\b(this|base)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.ps",
          "match": "\\b(void|bool|byte|sbyte|char|short|ushort|int|uint|long|ulong|float|double|decimal|string|object|dynamic|var)\\b"
        },
        {
          "name": "support.class.core.ps",
          "match": "\\b(Console|Math|List|Dict|HashSet|IEnumerable|IAsyncEnumerable|IAsyncEnumerator|IDisposable|IAsyncDisposable|Task|Exception|Tuple)\\b"
        },
        {
          "name": "entity.name.type.class.ps",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.ps",
          "match": "\\b0[xX][0-9a-fA-F_]+[uUlL]?\\b"
        },
        {
          "name": "constant.numeric.binary.ps",
          "match": "\\b0[bB][01_]+[uUlL]?\\b"
        },
        {
          "name": "constant.numeric.float.ps",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?[fFdDmM]?\\b"
        },
        {
          "name": "constant.numeric.integer.ps",
          "match": "\\b[0-9][0-9_]*([uUlL]|ul|UL)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.ps",
          "match": "=>"
        },
        {
          "name": "keyword.operator.null-coalescing.ps",
          "match": "\\?\\?=?|\\?\\."
        },
        {
          "name": "keyword.operator.comparison.ps",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.ps",
          "match": "(\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|=)"
        },
        {
          "name": "keyword.operator.arithmetic.ps",
          "match": "(\\+\\+|--|\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.logical.ps",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.bitwise.ps",
          "match": "(&|\\||\\^|~|<<|>>)"
        }
      ]
    },
    "method-calls": {
      "patterns": [
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.ps" }
          }
        }
      ]
    }
  }
}
