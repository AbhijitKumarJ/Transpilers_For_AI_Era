namespace Game.Physics;

public class RigidBody {
    public int Id;
    public Vector2 Position;
    public Vector2 Velocity;
    public double Mass;

    public RigidBody(int id, Vector2 pos, Vector2 vel, double mass) {
        this.Id = id;
        this.Position = pos;
        this.Velocity = vel;
        this.Mass = mass;
    }

    public void Integrate(double dt) {
        var delta = new Vector2(this.Velocity.X * dt, this.Velocity.Y * dt);
        this.Position = this.Position.Add(delta);
    }
}

