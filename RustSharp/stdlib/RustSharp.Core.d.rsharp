    [InlineTemplate("({0} as f64).floor()")]
    public static extern double Floor(double d);

    [InlineTemplate("({0} as f64).ceil()")]
    public static extern double Ceiling(double a);

    [InlineTemplate("({0} as f64).round()")]
    public static extern double Round(double a);

    [InlineTemplate("({0} as f64).powf({1} as f64)")]
    public static extern double Pow(double x, double y);

    [InlineTemplate("({0}).clamp({1}, {2})")]
    public static extern int Clamp(int value, int min, int max);
}

