    [CanonicalApi("PythonSharp.MachineLearning.GradientBoosting.XgBoostRegressorModel.EvaluateModelScore", "Score")]
    [MapsTo("score")]
    public extern double score(NDArray<double> X, NDArray<double> y);
}

