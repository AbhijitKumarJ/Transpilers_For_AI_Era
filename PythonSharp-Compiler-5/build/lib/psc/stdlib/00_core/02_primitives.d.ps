[MapsTo("Exception")]
public class Exception
{
    public extern Exception(string? message = null);

    [InlineTemplate("str({self})")]
    public extern string Message { get; }
}

[MapsTo("Exception")]
public class SystemException : Exception
{
    public extern SystemException(string? message = null);
}

[MapsTo("ValueError")]
public class ArgumentException : Exception
{
