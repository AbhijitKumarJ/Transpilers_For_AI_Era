    [MapsTo("math.pow")]
    public static extern double Pow(double x, double y);

    [MapsTo("math.exp")]
    public static extern double Exp(double value);

    [MapsTo("math.log")]
    public static extern double Log(double value);

    [MapsTo("math.sin")]
    public static extern double Sin(double value);

    [MapsTo("math.cos")]
    public static extern double Cos(double value);

    [MapsTo("math.tan")]
    public static extern double Tan(double value);

    [InlineTemplate("abs({0})")]
    public static extern double Abs(double value);

    [InlineTemplate("({0} if {0} >= {1} else {1})")]
    public static extern double Max(double a, double b);

    [InlineTemplate("({0} if {0} <= {1} else {1})")]
    public static extern double Min(double a, double b);

    [InlineTemplate("({1} if {0} < {1} else ({2} if {0} > {2} else {0}))")]
    public static extern double Clamp(double value, double min, double max);

    [InlineTemplate("float(math.ceil({0}))")]
    public static extern double Ceiling(double value);

    [InlineTemplate("float(math.floor({0}))")]
    public static extern double Floor(double value);

    [InlineTemplate("float(round({0}))")]
    public static extern double Round(double value);

    [InlineTemplate("float(math.trunc({0}))")]
    public static extern double Truncate(double value);

    [InlineTemplate("(0 if {0} == 0 else (1 if {0} > 0 else -1))")]
    public static extern int Sign(double value);
}

