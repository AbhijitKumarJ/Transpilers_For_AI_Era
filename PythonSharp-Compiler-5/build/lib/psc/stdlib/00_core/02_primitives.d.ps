    public static extern double from_(object x);
}

[MapsTo("bool")]
[RuntimeType("bool")]
public primitive class Boolean
{
    [InlineTemplate("({0}.lower() == 'true' if isinstance({0}, str) else bool({0}))")]
    public static extern bool Parse(string s);

    [InlineTemplate("({0}.lower() == 'true' if isinstance({0}, str) else bool({0}))")]
    public static extern bool parse(string s);

    [InlineTemplate("bool({0})")]
    public static extern bool From(object x);

    [InlineTemplate("bool({0})")]
    public static extern bool from_(object x);
}
