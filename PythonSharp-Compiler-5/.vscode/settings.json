{
  "files.associations": {
    "*.ps": "pythonsharp",
    "*.d.ps": "pythonsharp",
    "*.pysharp": "pythonsharp",
    "*.d.pysharp": "pythonsharp",
    "*.pys": "pythonsharp",
    "*.d.pys": "pythonsharp",
    "*.psproj": "xml",
    "*.pysharpproj": "xml"
  },
  "[pythonsharp]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.suggestOnTriggerCharacters": true,
    "editor.quickSuggestions": {
      "other": "on",
      "comments": "off",
      "strings": "off"
    }
  }
}

